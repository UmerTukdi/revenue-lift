# ==============================================================================
# Revenue Lift — Environment Configuration
# ==============================================================================

# Database Connection (SQLite dev or PostgreSQL production)
DATABASE_URL="file:./dev.db"

# Mode & Safety Flags
DEMO_MODE="true"
IS_SYNTHETIC_DATA="true"
DEMO_FORCE_EXECUTION_FAILURE="false"

# AI Provider Abstraction (defaults to deterministic mock engine if no key provided)
AI_PROVIDER="mock"
GEMINI_API_KEY=""

# Razorpay Test Mode Credentials (Never use production credentials)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Razorpay Webhook Secret for Signature Verification
RAZORPAY_WEBHOOK_SECRET=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
